From 548281df0983aa0b4e15c923e97d122419787078 Mon Sep 17 00:00:00 2001
From: "D. Manresa" <dmanresa@gmail.com>
Date: Sat, 5 Sep 2026 23:01:35 +0200
Subject: [PATCH] media: i2c: ov5693: add 2x2 binned 1296x972 mode

The driver already derives a 2x2 binned readout from set_fmt() when the
requested size is half the crop, but that mode has never streamed on an
IPU6: the sensor is programmed with only the full-resolution values of a
handful of registers, written once from ov5693_global_regs, so the binned
readout runs with a MIPI PLL multiplier (0x30b3) and analogue readout
timing meant for twice the line length. The CSI-2 receiver reports
"Transfer FIFO overflow" and every frame arrives empty.

Users have therefore had to read the sensor at full resolution and
downscale, which costs two stops of light. On the Surface Pro 7+ front
camera the AGC sits at its analogue-gain ceiling in ordinary room light
at full resolution; with 2x2 binning the gain needed for the same
exposure drops about tenfold, and the noise with it.

Make the binned mode work, following the vendor (Windows) driver's mode
table:

 - Write the per-mode PLL/analogue registers (0x30b3, 0x3600, 0x3620-2,
   0x3708-9, 0x371f) from ov5693_mode_configure() so they follow the
   readout mode instead of being fixed at the full-resolution values.

 - Use the vendor window geometry in the binned mode: crop the whole
   pixel array (0..2623 x 0..1955), bin it to 1312x978 and place the
   1296x972 output inside that with the sensor-ISP window offsets
   (0x3810/0x3812) rather than with the crop. Keeping the 2592x1944 crop
   so the binned readout exactly equals the output size with zero
   offsets leaves the ISP no spare pixels around the window and the
   frames fail CSI-2 framing ("Frame sync error", no frame completes);
   a zero X offset alone breaks it the same way. The X offset is the
   vendor's 8 in both horizontal-flip states: in the binned readout the
   mirror does not move the Bayer phase (the sensor ISP realigns the
   binning window, as the OV8865 does), so the offset has no interaction
   with the HFLIP handling, which is left as it is.

 - Make the Y offset a module parameter, binned_y_offset, default 2.
   Its parity selects the Bayer phase of the binned output: 2 (even)
   keeps the BGGR phase the driver advertises, 3 (odd, the vendor's
   value) yields GRBG, which is what the Intel IPU6 PSYS program groups
   built from the OEM tuning expect. Users of the proprietary IPU6 ISP
   stack can switch with "modprobe ov5693 binned_y_offset=3" until the
   driver can report the phase change through the mbus code.

 - Use only the sensor-side FLIP_VERT bit for a vertical flip in the
   binned mode. Setting both the sensor and the ISP bit there corrupts
   the CSI-2 framing (the receiver never completes a frame), the ISP bit
   alone does not flip the picture, and the sensor bit alone streams and
   flips. It inverts the vertical Bayer phase, which the even Y offset
   above keeps in place; the flip control is re-applied from
   ov5693_mode_configure() because the bit set depends on the mode.

 - Cap the default frame rate at 30 fps. The VTS heuristic picks 60 fps
   for the binned height, halving VTS to 1038, but the binned mode runs
   off a slower MIPI PLL and the link cannot carry twice the frame rate
   (again "Frame sync error"). The vendor driver runs this mode at VTS
   1984; staying at 30 fps also keeps the VTS-bound exposure ceiling
   where it was.

Also document, next to the BLC registers in the init table, that these
are the vendor's values and that the sensor holds its black pedestal at
~16 LSB (10-bit) at every analogue gain (measured with dark captures).

Everything here was measured on a Microsoft Surface Pro 7+ (IPU6 Tiger
Lake, INT33BE) against raw captures at both resolutions and in all four
flip states, with libcamera's software ISP and with the Intel IPU6 PSYS
stack. The full-resolution register writes are unchanged.

Assisted-by: LLM (Anthropic Claude, Fable 5)
Signed-off-by: D. Manresa <dmanresa@gmail.com>
---
 drivers/media/i2c/ov5693.c | 155 ++++++++++++++++++++++++++++++++++---
 1 file changed, 143 insertions(+), 12 deletions(-)

diff --git a/drivers/media/i2c/ov5693.c b/drivers/media/i2c/ov5693.c
index cedc6ea..9e006be 100644
--- a/drivers/media/i2c/ov5693.c
+++ b/drivers/media/i2c/ov5693.c
@@ -129,6 +129,19 @@
 
 #define to_ov5693_sensor(x) container_of(x, struct ov5693_device, sd)
 
+/*
+ * ISP window Y offset used in the 2x2 binned mode. Its parity selects the
+ * Bayer phase of the output: 2 (even) keeps the advertised BGGR phase, which
+ * is what a V4L2 receiver and libcamera's software ISP expect; 3 (odd, the
+ * vendor driver's value) yields the GRBG phase that the IPU6 PSYS program
+ * groups built from the vendor tuning expect. Switch with:
+ *	modprobe ov5693 binned_y_offset=3
+ */
+static int binned_y_offset = 2;
+module_param(binned_y_offset, int, 0644);
+MODULE_PARM_DESC(binned_y_offset,
+		 "Binned-mode ISP window Y offset (2 = BGGR, 3 = GRBG)");
+
 static const char * const ov5693_supply_names[] = {
 	"avdd",		/* Analog power */
 	"dovdd",	/* Digital I/O power */
@@ -293,6 +306,13 @@ static const struct cci_reg_sequence ov5693_global_regs[] = {
 	{CCI_REG8(0x3a04), 0x06},
 	{CCI_REG8(0x3a05), 0x14},
 	{CCI_REG8(0x3e07), 0x20},
+	/*
+	 * BLC: the same values the vendor driver writes. The sensor keeps its
+	 * black pedestal at ~16 LSB (10-bit) at every analogue gain (measured
+	 * with dark captures on a Surface Pro 7+; adding the remaining vendor
+	 * BLC registers 0x4002/0x4005/0x400c/0x400d/0x404e/0x404f does not
+	 * change that).
+	 */
 	{CCI_REG8(0x4000), 0x08},
 	{CCI_REG8(0x4001), 0x04},
 	{CCI_REG8(0x4004), 0x08},
@@ -361,15 +381,36 @@ static const u8 ov5693_test_pattern_bits[] = {
 
 /* V4L2 Controls Functions */
 
+/*
+ * Which FORMAT1 bits express a vertical flip depends on the readout mode.
+ *
+ * At full resolution both the sensor-side and the ISP-side bit are used, as
+ * the datasheet describes. With 2x2 binning, setting both corrupts the CSI-2
+ * framing: an IPU6 receiver reports "Frame sync error" on every frame and no
+ * data arrives at all. The ISP bit alone streams cleanly but does not
+ * actually flip the picture, so the sensor-side bit alone is the one that
+ * both streams and flips. It also inverts the vertical Bayer phase, which
+ * the even ISP window offset in ov5693_mode_configure() keeps in place --
+ * measured on a Surface Pro 7+ against the full-resolution orientation.
+ */
+static u8 ov5693_flip_vert_bits(struct ov5693_device *ov5693)
+{
+	if (ov5693->mode.binning_y)
+		return OV5693_FORMAT1_FLIP_VERT_SENSOR_EN;
+
+	return OV5693_FORMAT1_FLIP_VERT_ISP_EN |
+	       OV5693_FORMAT1_FLIP_VERT_SENSOR_EN;
+}
+
 static int ov5693_flip_vert_configure(struct ov5693_device *ov5693,
 				      bool enable)
 {
-	u8 bits = OV5693_FORMAT1_FLIP_VERT_ISP_EN |
+	u8 mask = OV5693_FORMAT1_FLIP_VERT_ISP_EN |
 		  OV5693_FORMAT1_FLIP_VERT_SENSOR_EN;
 	int ret;
 
-	ret = cci_update_bits(ov5693->regmap, OV5693_FORMAT1_REG, bits,
-			      enable ? bits : 0, NULL);
+	ret = cci_update_bits(ov5693->regmap, OV5693_FORMAT1_REG, mask,
+			      enable ? ov5693_flip_vert_bits(ov5693) : 0, NULL);
 	if (ret)
 		return ret;
 
@@ -557,17 +598,76 @@ static const struct v4l2_ctrl_ops ov5693_ctrl_ops = {
 
 /* System Control Functions */
 
+/*
+ * Registers the vendor driver programs differently for the full-resolution
+ * and the 2x2 binned readout, taken from its mode tables.
+ *
+ * The driver used to write only the full-resolution values, once, from
+ * ov5693_global_regs, and never revisit them. Selecting the binned mode
+ * therefore left the sensor with a MIPI PLL multiplier (0x30b3) and analogue
+ * readout timing meant for twice the line length. On an IPU6 the receiver
+ * then reports "Transfer FIFO overflow" and every frame arrives empty, which
+ * is why the binned mode has been unusable -- and why the sensor has had to
+ * be read at full resolution and downscaled, costing two stops of light and
+ * forcing the AGC to its maximum analogue gain.
+ */
+static const struct cci_reg_sequence ov5693_mode_full_regs[] = {
+	{CCI_REG8(0x30b3), 0x83},	/* MIPI PLL multiplier */
+	{CCI_REG8(0x3620), 0x54},
+	{CCI_REG8(0x3621), 0xc7},
+	{CCI_REG8(0x3622), 0x0f},
+	{CCI_REG8(0x3708), 0xe2},
+	{CCI_REG8(0x3709), 0xc3},
+	{CCI_REG8(0x371f), 0x0c},
+};
+
+static const struct cci_reg_sequence ov5693_mode_binned_regs[] = {
+	{CCI_REG8(0x30b3), 0x70},	/* MIPI PLL multiplier */
+	{CCI_REG8(0x3600), 0xbc},	/* analogue, vendor sets it binned-only */
+	{CCI_REG8(0x3620), 0x44},
+	{CCI_REG8(0x3621), 0xb5},
+	{CCI_REG8(0x3622), 0x0c},
+	{CCI_REG8(0x3708), 0xe6},
+	{CCI_REG8(0x3709), 0xc7},
+	{CCI_REG8(0x371f), 0x1f},
+};
+
 static int ov5693_mode_configure(struct ov5693_device *ov5693)
 {
 	const struct ov5693_mode *mode = &ov5693->mode;
+	bool binned = mode->binning_x || mode->binning_y;
 	int ret = 0;
 
+	/*
+	 * Readout geometry. At full resolution this is the crop rectangle
+	 * selected over the media API, with the sensor-ISP window offsets at
+	 * zero.
+	 *
+	 * The binned mode instead copies the vendor driver: read the whole
+	 * pixel array (0..2623 x 0..1955), bin it to 1312x978, and let the
+	 * ISP window offsets place the 1296x972 output inside that. The X
+	 * offset is the vendor's 8; it is the same in both horizontal flip
+	 * states, because in the binned readout the mirror does not move the
+	 * Bayer phase (the sensor ISP realigns the binning window, as the
+	 * OV8865 does). The Y offset is 2 rather than the vendor's 3: an odd
+	 * offset shifts the Bayer phase by one row, which the vendor ISP knows
+	 * about but a V4L2 receiver does not (see binned_y_offset).
+	 *
+	 * The obvious alternative -- keeping the 2592x1944 crop so the binned
+	 * readout exactly equals the output size with zero offsets -- leaves
+	 * the sensor ISP without spare pixels around the window, and the
+	 * frames it emits then fail CSI-2 framing ("Frame sync error" on the
+	 * IPU6, no frame ever completes). A zero X offset alone breaks the
+	 * framing the same way.
+	 */
+
 	/* Crop Start X */
-	cci_write(ov5693->regmap, OV5693_CROP_START_X_REG, mode->crop.left,
-		  &ret);
+	cci_write(ov5693->regmap, OV5693_CROP_START_X_REG,
+		  binned ? 0 : mode->crop.left, &ret);
 
 	/* Offset X */
-	cci_write(ov5693->regmap, OV5693_OFFSET_START_X_REG, 0, &ret);
+	cci_write(ov5693->regmap, OV5693_OFFSET_START_X_REG, binned ? 8 : 0,
+		  &ret);
 
 	/* Output Size X */
 	cci_write(ov5693->regmap, OV5693_OUTPUT_SIZE_X_REG, mode->format.width,
@@ -575,18 +675,20 @@ static int ov5693_mode_configure(struct ov5693_device *ov5693)
 
 	/* Crop End X */
 	cci_write(ov5693->regmap, OV5693_CROP_END_X_REG,
-		  mode->crop.left + mode->crop.width, &ret);
+		  binned ? OV5693_NATIVE_WIDTH - 1 :
+			   mode->crop.left + mode->crop.width, &ret);
 
 	/* Horizontal Total Size */
 	cci_write(ov5693->regmap, OV5693_TIMING_HTS_REG, OV5693_FIXED_PPL,
 		  &ret);
 
 	/* Crop Start Y */
-	cci_write(ov5693->regmap, OV5693_CROP_START_Y_REG, mode->crop.top,
-		  &ret);
+	cci_write(ov5693->regmap, OV5693_CROP_START_Y_REG,
+		  binned ? 0 : mode->crop.top, &ret);
 
-	/* Offset Y */
-	cci_write(ov5693->regmap, OV5693_OFFSET_START_Y_REG, 0, &ret);
+	/* Offset Y: parity picks the Bayer phase, see binned_y_offset. */
+	cci_write(ov5693->regmap, OV5693_OFFSET_START_Y_REG,
+		  binned ? binned_y_offset : 0, &ret);
 
 	/* Output Size Y */
 	cci_write(ov5693->regmap, OV5693_OUTPUT_SIZE_Y_REG, mode->format.height,
@@ -594,7 +696,8 @@ static int ov5693_mode_configure(struct ov5693_device *ov5693)
 
 	/* Crop End Y */
 	cci_write(ov5693->regmap, OV5693_CROP_END_Y_REG,
-		  mode->crop.top + mode->crop.height, &ret);
+		  binned ? OV5693_NATIVE_HEIGHT - 1 :
+			   mode->crop.top + mode->crop.height, &ret);
 
 	/* Subsample X increase */
 	cci_write(ov5693->regmap, OV5693_SUB_INC_X_REG,
@@ -612,6 +715,24 @@ static int ov5693_mode_configure(struct ov5693_device *ov5693)
 			OV5693_FORMAT2_HBIN_EN,
 			mode->binning_x ? OV5693_FORMAT2_HBIN_EN : 0, &ret);
 
+	/*
+	 * The set of FORMAT1 bits that means "vertical flip" changes with the
+	 * readout mode, so re-apply the control now that binning is known.
+	 */
+	if (ov5693->ctrls.vflip && ov5693->ctrls.vflip->val)
+		cci_update_bits(ov5693->regmap, OV5693_FORMAT1_REG,
+				OV5693_FORMAT1_FLIP_VERT_ISP_EN |
+				OV5693_FORMAT1_FLIP_VERT_SENSOR_EN,
+				ov5693_flip_vert_bits(ov5693), &ret);
+
+	/* PLL and analogue readout timing follow the readout mode. */
+	if (binned)
+		cci_multi_reg_write(ov5693->regmap, ov5693_mode_binned_regs,
+				    ARRAY_SIZE(ov5693_mode_binned_regs), &ret);
+	else
+		cci_multi_reg_write(ov5693->regmap, ov5693_mode_full_regs,
+				    ARRAY_SIZE(ov5693_mode_full_regs), &ret);
+
 	return ret;
 }
 
@@ -783,6 +904,16 @@ static unsigned int __ov5693_calc_vts(u32 height)
 
 	tgt_fps = rounddown(OV5693_PIXEL_RATE / OV5693_FIXED_PPL / height, 30);
 
+	/*
+	 * Cap at 30fps. Left alone this picks 60fps for the 2x2 binned mode,
+	 * which halves VTS to 1038 -- and the binned readout runs off a slower
+	 * MIPI PLL (0x30b3), so the link cannot carry twice the frame rate:
+	 * the IPU6 reports "Frame sync error" and no frame ever completes. The
+	 * vendor driver runs the same mode at VTS 1984. Staying at 30fps also
+	 * keeps the exposure ceiling, which is VTS bound, where it was.
+	 */
+	tgt_fps = min(tgt_fps, 30U);
+
 	return ALIGN_DOWN(OV5693_PIXEL_RATE / OV5693_FIXED_PPL / tgt_fps, 2);
 }
 
