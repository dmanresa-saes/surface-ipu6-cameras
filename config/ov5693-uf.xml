<?xml version="1.0" encoding="UTF-8" ?>
<!-- Surface Pro 7+ front camera (OV5693, MSHW0220) profile for the Intel
     IPU6 camera HAL, running on the MAINLINE isys driver (mediaCfg=1 graph:
     "ov5693 <i2c>" -> "Intel IPU6 CSI2 <port>" -> "Intel IPU6 ISYS Capture").
     Sensor runs the 2x2-binned 1296x972 SBGGR10 mode (the mode Windows uses).
     Tuning: OV5693_MSHW0220_TGL.aiqb + graph_settings_ov5693.xml, both taken
     from the Microsoft Surface Pro 7+ driver MSI. -->

<CameraSettings>
    <Sensor name="ov5693-uf" description="OV5693 Surface front sensor.">
        <MediaCtlConfig id="0" mediaCfg="1" ConfigMode="AUTO" outputWidth="1296" outputHeight="972" format="V4L2_PIX_FMT_SBGGR10"><!-- RAW10 binned -->
            <control name="ov5693 $I2CBUS" ctrlId="V4L2_CID_VFLIP" value="1" ctrlName="set vflip"/>
            <control name="ov5693 $I2CBUS" ctrlId="V4L2_CID_HFLIP" value="0" ctrlName="set hflip"/>
            <format name="ov5693 $I2CBUS" pad="0" width="1296" height="972" format="V4L2_MBUS_FMT_SBGGR10_1X10"/>
            <format name="Intel IPU6 CSI2 $CSI_PORT" pad="0" width="1296" height="972" format="V4L2_MBUS_FMT_SBGGR10_1X10"/>

            <link srcName="ov5693 $I2CBUS" srcPad="0" sinkName="Intel IPU6 CSI2 $CSI_PORT" sinkPad="0" enable="true"/>
            <link srcName="Intel IPU6 CSI2 $CSI_PORT" srcPad="1" sinkName="Intel IPU6 ISYS Capture $CAPTURE_ID" sinkPad="0" enable="true"/>

            <videonode name="Intel IPU6 ISYS Capture $CAPTURE_ID" videoNodeType="VIDEO_GENERIC"/>
            <videonode name="Intel IPU6 CSI2 $CSI_PORT" videoNodeType="VIDEO_ISYS_RECEIVER"/>
            <videonode name="ov5693 $I2CBUS" videoNodeType="VIDEO_PIXEL_ARRAY"/>
        </MediaCtlConfig>

        <StaticMetadata>
            <!-- format,widthxheight,field(none:0,alternate:7),mcId -->
            <supportedStreamConfig value="V4L2_PIX_FMT_NV12,1280x720,0,0,
                                          V4L2_PIX_FMT_NV12,1280x960,0,0,
                                          V4L2_PIX_FMT_NV12,640x480,0,0,
                                          V4L2_PIX_FMT_YUYV,1280x720,0,0,
                                          V4L2_PIX_FMT_YUYV,1280x960,0,0,
                                          V4L2_PIX_FMT_YUYV,640x480,0,0,
                                          V4L2_PIX_FMT_YUYV,640x360,0,0"/>

            <supportedFeatures value="MANUAL_EXPOSURE,
                                      MANUAL_WHITE_BALANCE,
                                      IMAGE_ENHANCEMENT,
                                      NOISE_REDUCTION,
                                      PER_FRAME_CONTROL,
                                      SCENE_MODE"/>
            <supportedAeExposureTimeRange value="AUTO,100,33333"/>
            <supportedAeGainRange value="AUTO,0,60"/>
            <fpsRange value="15,15,15,30,30,30"/>
            <evRange value="-6,6"/>
            <evStep value="1,3"/>
            <supportedAeMode value="AUTO,MANUAL"/>
            <supportedVideoStabilizationModes value="OFF"/>
            <supportedSceneMode value="NORMAL"/>
            <supportedAntibandingMode value="AUTO,50Hz,60Hz,OFF"/>
            <supportedAwbMode value="AUTO,INCANDESCENT,FLUORESCENT,DAYLIGHT,FULL_OVERCAST,PARTLY_OVERCAST,SUNSET,VIDEO_CONFERENCE,MANUAL_CCT_RANGE,MANUAL_WHITE_POINT,MANUAL_GAIN,MANUAL_COLOR_TRANSFORM"/>
            <supportedAfMode value="OFF"/>
        </StaticMetadata>

        <supportedTuningConfig value="NORMAL,VIDEO,OV5693_MSHW0220_TGL,STILL_CAPTURE,VIDEO,OV5693_MSHW0220_TGL"/>

        <!-- <TuningMode, cmc tag, aiq tag, isp tag, others tag> -->
        <lardTags value="VIDEO,DFLT,DFLT,DFLT,DFLT"/>

        <supportedISysSizes value="1296x972"/> <!-- ascending order request -->
        <supportedISysFormat value="V4L2_PIX_FMT_SBGGR10"/>
        <enableAIQ value="true"/>
        <iSysRawFormat value="V4L2_PIX_FMT_SBGGR10"/>
        <pSysFormat value="V4L2_PIX_FMT_NV12"/>
        <initialSkipFrame value="0"/>
        <exposureLag value="2"/>
        <gainLag value="2"/>
        <ltmGainLag value="1"/>
        <yuvColorRangeMode value="full"/>
        <graphSettingsFile value="graph_settings_ov5693.xml"/>
        <graphSettingsType value="dispersed"/>
        <enablePSysProcessor value="true"/>
        <dvsType value="IMG_TRANS"/>
        <enableAiqd value="true"/>
        <useCrlModule value="false"/>
        <maxRequestsInflight value="5"/>
    </Sensor>
</CameraSettings>
